<?xml version="1.0" encoding="utf-8"?>
<!-- Universidad: celeste que se profundiza hacia la esquina inferior. Every layer keeps the 24dp corners so nothing spills outside the rounded card. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Diagonal base gradient. -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315"
                android:startColor="#EAF7FF" android:centerColor="#CBE7FD" android:endColor="#A3CDF6" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Soft light behind the header. -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.85" android:centerY="0.0" android:gradientRadius="190dp"
                android:startColor="#B3FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Tinted glow that anchors the bottom-left corner. -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.0" android:centerY="1.0" android:gradientRadius="170dp"
                android:startColor="#4D1C6FBF" android:endColor="#00FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Thin glassy edge. -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#8CFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
