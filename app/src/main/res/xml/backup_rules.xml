<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 and lower. Backups are disabled with allowBackup="false"; these exclusions
   keep session tokens and other people's schedules out even if that flag changes.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
