<?xml version="1.0" encoding="utf-8"?>
<!--
    Fixed 4×2: the widget cannot be resized. Android 12+ launchers place it with targetCell*.
    Some launchers (e.g. Xiaomi/POCO HyperOS) ignore targetCell* and round minWidth/minHeight up
    to their own, shorter cells, so minHeight is kept low: 90dp is still 2 rows under the classic
    70 × cells − 30 rule (1 row = 40dp, 2 rows = 110dp) but no longer spills into a third row.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="210dp"
    android:minHeight="90dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:configure="com.example.findme.widget.StatusWidgetConfigurationActivity"
    android:widgetFeatures="reconfigurable"
    android:description="@string/status_widget_description"
    android:previewLayout="@layout/widget_status_preview"
    android:initialLayout="@layout/widget_status_preview"
    android:updatePeriodMillis="0"
    android:resizeMode="none"
    android:widgetCategory="home_screen" />
