<?xml version="1.0" encoding="utf-8"?>
<!--
    Fixed 4×3: the widget cannot be resized. Android 12+ launchers place it with targetCell*.
    minWidth/minHeight give the same 4×3 on older launchers (70 × cells − 30 rule) while staying
    small enough that no Android 12+ grid rounds them above 4 columns or 3 rows.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="210dp"
    android:minHeight="150dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:configure="com.example.findme.widget.StatusWidgetConfigurationActivity"
    android:widgetFeatures="reconfigurable"
    android:description="@string/status_widget_description"
    android:previewLayout="@layout/widget_status_preview"
    android:initialLayout="@layout/widget_status_preview"
    android:updatePeriodMillis="0"
    android:resizeMode="none"
    android:widgetCategory="home_screen" />
